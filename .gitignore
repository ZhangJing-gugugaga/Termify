outputs/

# Logs
logs/
*.log

# Claude session / memory data (personal, not part of the product)
.claude/

# Environment / secrets — never commit real credentials
.env
.env.*
*.pem
*.key
.secrets/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Python REPL history
.python_history

# Playwright MCP screenshots + console logs
.playwright-mcp/
*.png

# throwaway dev scripts
_e2e.py
_fixline.py
tmp/_*.html

# browser-test scratch (salarycat copy + validation HTML)
static/test/

# throwaway one-off scripts
_*.py

# Allow documentation images
!images/
!images/*.png
!images/screenshots/
!images/screenshots/*.png

# Allow shipped favicon raster (logo fallback for clients without SVG/ICO support)
!static/img/favicon-32.png

# Tool config and session data (personal, not part of the product)
.mimocode/
.workbuddy/

# Test artifacts (temporary, regenerable)
test_*.json
test_*.py
# ...但 tests/ 下的正式用例必须入库：上面的 test_*.py 本意是仓库根/临时目录
# 里的调试脚本，却会连带忽略 tests/ 下的新用例（已跟踪的旧文件不受影响，
# 所以只在新增测试时才暴露——提交时极易漏掉）。
!tests/test_*.py
static/geometric_preview.html
data/

# Tool scratch files (op edits leave .lock markers; probes write tmp_*)
.dsh-ops-update-*.lock
tmp_*


# Screenshots / preview images (local dev artifacts)
*_preview.png
main_page*.png
*.log

# Test temp images and fixtures
_t*tmp.png
_test_*.png
test_bright.png
test_dark.png
*.json
# …但烘焙作品库的 manifest 与字形墨量表要随仓库走（.json.gz 的
# 否定规则不需要：*.json 不匹配 *​.json.gz）
!static/anim/manifest.json
!static/anim/ink.json

# meow-memory 本地记忆库（可能含会话私密内容，绝不入库）
.dsh-meow/

# PyInstaller artifacts
build/
dist/
*.spec.bak
